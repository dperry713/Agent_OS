<UserControl
    x:Class="AetherShell.App.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#1F1F1F" CornerRadius="8" Padding="16" Width="600">
        <StackPanel>
            <TextBox x:ConnectionId='2' x:Name="SearchBox" PlaceholderText="Ask AI or type command..." />
            <!-- AI suggestions list, history, etc. -->
            <ListView x:ConnectionId='3' x:Name="SuggestionsList" />
        </StackPanel>
    </Border>
</UserControl>

