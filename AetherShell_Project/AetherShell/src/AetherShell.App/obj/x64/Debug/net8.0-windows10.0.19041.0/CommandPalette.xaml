<UserControl
    x:Class="AetherShell.App.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Center">

    <Border Background="#18181B" 
            BorderBrush="#3F3F46" 
            BorderThickness="1" 
            CornerRadius="12" 
            Width="650" 
            Padding="12">
        <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox x:ConnectionId='4' x:Name="SearchBox" 
                         PlaceholderText="Ask Aether Assistant or type a command... (Press Enter to execute)" 
                         Background="#27272A" 
                         BorderThickness="0" 
                         Foreground="#FFFFFF" 
                         FontSize="15" 
                         Padding="10,8" 
                         CornerRadius="6"
                                                    
                         Grid.Column="0"/>
                <Button x:ConnectionId='5' x:Name="MicButton"
                        Content="🎤"
                        Background="#3F3F46"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="8,0,0,0"
                                               
                        Grid.Column="1"/>
                <Button x:ConnectionId='6' Content="Submit"
                        Background="#A855F7"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        CornerRadius="6"
                        Padding="12,8"
                        Margin="8,0,0,0"
                                                  
                        Grid.Column="2"/>
            </Grid>
            
            <MenuFlyoutSeparator Background="#3F3F46" Height="1" Margin="0,4"/>

            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ListView x:ConnectionId='2' x:Name="SuggestionsList" Background="Transparent" BorderThickness="0" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,8" ColumnDefinitions="Auto,*">
                                <FontIcon Glyph="&#xE90A;" FontFamily="Segoe MDL2 Assets" Foreground="#A855F7" Margin="0,0,12,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Query}" FontWeight="SemiBold" Foreground="#E4E4E7" FontSize="13"/>
                                    <TextBlock Text="{Binding Response}" Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>

