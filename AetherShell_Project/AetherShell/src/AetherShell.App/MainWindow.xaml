<Window
    x:Class="AetherShell.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AetherShell.App"
    Title="AetherShell">

    <Grid Background="#09090B">
        <!-- Main Shell Grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Width="260" Background="#121214" BorderBrush="#202023" BorderThickness="0,0,1,0" Padding="20">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Title/Header -->
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,16,0,24">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="24" Height="24" Fill="#A855F7"/>
                            <TextBlock Text="AetherShell" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="AI-First Desktop OS v1.0" FontSize="11" Foreground="#71717A" Margin="34,0,0,0"/>
                    </StackPanel>

                    <!-- Nav Items -->
                    <StackPanel Grid.Row="1" Spacing="8">
                        <Button x:Name="NavDashboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6" Click="NavDashboard_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="#A855F7"/>
                                <TextBlock Text="Home Dashboard" Foreground="#FFFFFF" FontSize="14" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavVision" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6" Click="NavVision_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE722;" FontFamily="Segoe MDL2 Assets" Foreground="#3B82F6"/>
                                <TextBlock Text="Vision Analyzer" Foreground="#E4E4E7" FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavAutomation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6" Click="NavAutomation_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE9D5;" FontFamily="Segoe MDL2 Assets" Foreground="#10B981"/>
                                <TextBlock Text="Automation Engine" Foreground="#E4E4E7" FontSize="14"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavSettings" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6" Click="NavSettings_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#6B7280"/>
                                <TextBlock Text="System Settings" Foreground="#E4E4E7" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Status / User Panel -->
                    <StackPanel Grid.Row="2" Spacing="12" Margin="0,0,0,12">
                        <Border Background="#1C1C1F" CornerRadius="6" Padding="12,8">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center"/>
                                    <TextBlock Text="AgentOS Daemon Active" FontSize="12" Foreground="#D4D4D8" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Running Hello-World Loop" FontSize="11" Foreground="#71717A"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Work Area Content -->
            <Grid Grid.Column="1" Background="#09090B">
                <!-- Dashboard View -->
                <Grid x:Name="ViewDashboard" Visibility="Visible" Padding="32" RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
                        <TextBlock Text="Welcome back, Administrator" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="AetherShell AI-Agent modules are active and listening." FontSize="14" Foreground="#A1A1AA"/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,*" RowSpacing="20" ColumnSpacing="20">
                        <!-- Card 1: Core AI -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="Supervisor AI" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="Primary planner decomposing user directives and delegating workflows to local model orchestrators." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                                <Button Grid.Row="2" Content="Toggle Command Palette" Margin="0,12,0,0" Background="#A855F7" Foreground="#FFFFFF" BorderThickness="0" CornerRadius="4" Click="TogglePaletteButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Card 2: Vision OCR -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="Vision Analyzer" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="Captures window and monitor layouts to extract text, structure, and accessibility states via ONNX." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                                <Button Grid.Row="2" Content="Scan Desktop Frame" Margin="0,12,0,0" Background="#3B82F6" Foreground="#FFFFFF" BorderThickness="0" CornerRadius="4" Click="NavVision_Click"/>
                            </Grid>
                        </Border>

                        <!-- Card 3: Automation -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="Workflow Automation" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="Executes scheduled cron triggers and agent automation loops using custom system hooks." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                                <Button Grid.Row="2" Content="Manage Workflows" Margin="0,12,0,0" Background="#10B981" Foreground="#FFFFFF" BorderThickness="0" CornerRadius="4" Click="NavAutomation_Click"/>
                            </Grid>
                        </Border>

                        <!-- Card 4: Plugins -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="Settings &amp; Preferences" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="Tune temperature sliders, select LLM weights, configure system themes and voice dictation modules." Foreground="#A1A1AA" FontSize="13" TextWrapping="Wrap"/>
                                <Button Grid.Row="2" Content="Open Config Page" Margin="0,12,0,0" Background="#6B7280" Foreground="#FFFFFF" BorderThickness="0" CornerRadius="4" Click="NavSettings_Click"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Vision Analyzer View -->
                <Grid x:Name="ViewVision" Visibility="Collapsed" Padding="32" RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
                        <TextBlock Text="Vision Analyzer Module" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Extract OCR layout structure and run local model descriptions." FontSize="14" Foreground="#A1A1AA"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="24">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Button Grid.Row="0" Content="Run Real-time Screen Analysis" Background="#3B82F6" Foreground="#FFFFFF" BorderThickness="0" CornerRadius="4" Padding="16,10" Click="AnalyzeButton_Click"/>
                            <Border Grid.Row="1" Background="#09090B" BorderThickness="1" BorderBrush="#27272A" CornerRadius="6" Margin="0,16" Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="VisionOutputText" Text="Click the button above to execute ScreenAnalyzer.AnalyzeScreenAsync(). Output results will be displayed here." Foreground="#D4D4D8" FontSize="13" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                            <TextBlock Grid.Row="2" Text="Uses Windows.Graphics.Capture API to feed raw desktop frames into Microsoft ONNX Runtime models." FontSize="11" Foreground="#71717A"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Automation View -->
                <Grid x:Name="ViewAutomation" Visibility="Collapsed" Padding="32" RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,24">
                        <TextBlock Text="Automation Engine Module" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Design and execute customizable task automation scripts." FontSize="14" Foreground="#A1A1AA"/>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,1.2*" ColumnSpacing="24">
                        <!-- Left Panel: Script Designer & Presets -->
                        <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Workflow Designer" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Load Preset Template" FontSize="13" Foreground="#A1A1AA"/>
                                    <ComboBox x:Name="PresetWorkflowSelector" SelectedIndex="0" HorizontalAlignment="Stretch" Background="#27272A" BorderBrush="#3F3F46" SelectionChanged="PresetWorkflowSelector_SelectionChanged">
                                        <ComboBoxItem Content="Custom Workflow Script..."/>
                                        <ComboBoxItem Content="Standard Clean &amp; Rebuild"/>
                                        <ComboBoxItem Content="System Health Scan"/>
                                        <ComboBoxItem Content="Full Test &amp; Deploy Pipeline"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Workflow Script Steps (Semicolon separated)" FontSize="13" Foreground="#A1A1AA"/>
                                    <TextBox x:Name="WorkflowScriptBox" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             Height="140" 
                                             Background="#27272A" 
                                             BorderBrush="#3F3F46" 
                                             Foreground="#FFFFFF" 
                                             FontSize="13" 
                                             PlaceholderText="e.g. Clean; Build; Test; Notify"
                                             Padding="10,8" 
                                             CornerRadius="4"/>
                                </StackPanel>

                                <Button x:Name="RunCustomWorkflowBtn" 
                                        Content="Execute Workflow Script" 
                                        Background="#10B981" 
                                        Foreground="#FFFFFF" 
                                        BorderThickness="0" 
                                        CornerRadius="4" 
                                        Padding="16,10" 
                                        HorizontalAlignment="Stretch" 
                                        Click="RunCustomWorkflowButton_Click"/>
                                
                                <TextBlock Text="Syntax: Enter steps separated by semicolon. Standard tasks include: Clean, Build, Test, Deploy, Notify, Diagnose." FontSize="11" Foreground="#71717A" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Right Panel: Live Execution Log -->
                        <Border Grid.Column="1" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Row="0" Text="Live Execution Log" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                                <Border Grid.Row="1" Background="#09090B" BorderThickness="1" BorderBrush="#27272A" CornerRadius="6" Padding="16">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="AutomationOutputText" Text="Workflow output and execution logs will display here." Foreground="#D4D4D8" FontSize="13" TextWrapping="Wrap" FontFamily="Consolas"/>
                                    </ScrollViewer>
                                </Border>
                                <TextBlock Grid.Row="2" Text="Real-time telemetry and task status provided by local automation daemon." FontSize="11" Foreground="#71717A" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Settings Page Frame View -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <Frame x:Name="SettingsFrame"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Command Palette Floating Overlay -->
        <Grid Grid.Row="0" x:Name="CommandPaletteOverlay" Background="#90000000" Visibility="Collapsed" Canvas.ZIndex="10" PointerPressed="CommandPaletteOverlay_PointerPressed">
            <local:CommandPalette x:Name="CommandPaletteControl" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <!-- Taskbar -->
        <Border Grid.Row="1" Height="54" Background="#121214" BorderBrush="#202023" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Taskbar Icons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <Button Width="36" Height="36" Background="Transparent" BorderThickness="0" CornerRadius="18" Click="NavDashboard_Click">
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" Foreground="#A855F7" FontSize="16"/>
                    </Button>
                    <Button Width="36" Height="36" Background="Transparent" BorderThickness="0" CornerRadius="18" Click="TogglePaletteButton_Click">
                        <FontIcon Glyph="&#xE90A;" FontFamily="Segoe MDL2 Assets" Foreground="#FFFFFF" FontSize="16"/>
                    </Button>
                    <Button Width="36" Height="36" Background="Transparent" BorderThickness="0" CornerRadius="18" Click="NavSettings_Click">
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#6B7280" FontSize="16"/>
                    </Button>
                </StackPanel>

                <!-- Center Active App Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <Border Background="#1C1C1F" Padding="12,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" Fill="#A855F7" VerticalAlignment="Center"/>
                            <TextBlock Text="AI Supervisor Ready" FontSize="11" Foreground="#E4E4E7"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#1C1C1F" Padding="12,6" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                            <TextBlock Text="AgentOS Connected" FontSize="11" Foreground="#E4E4E7"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- System Clock / Notification Area -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="10:15 PM" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        <TextBlock Text="6/30/2026" FontSize="10" Foreground="#71717A" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="#A1A1AA" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>